      "css": ".ds-p{display:flex;gap:6px;align-items:center;font-family:Outfit,system-ui,sans-serif;text-transform:uppercase;font-weight:700}.ds-p .p{padding:7px 16px 7px 12px;font-size:11px;letter-spacing:.12em;background:#171a1f;color:#a8b1bc;clip-path:polygon(0 0,100% 0,calc(100% - 6px) 100%,0 100%)}.ds-p .p.on{background:#3fd9a4;color:#0a0b0d}.ds-p .t{padding:3px 11px 3px 8px;font-size:11px;letter-spacing:.14em;background:#171a1f;clip-path:polygon(0 0,100% 0,calc(100% - 5px) 100%,0 100%)}.ds-p .ok{color:#3fd9a4}.ds-p .f{background:#d98b8b;color:#0a0b0d}"
