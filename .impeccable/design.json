      "css": ".ds-tabs{display:inline-flex;height:40px;border:1px solid #1e2228}.ds-tabs button{padding:0 20px;border:0;background:#0e1014;color:#a8b1bc;font:800 13px Outfit,system-ui,sans-serif;letter-spacing:.12em;text-transform:uppercase}.ds-tabs [aria-selected=true]{background:#3fd9a4;color:#0a0b0d}"
    },
    {
      "name": "Boss Tile",
      "kind": "custom",
      "refersTo": "boss-tile",
      "description": "Signature: head strip over upgrade list; best tile framed in gold.",
      "html": "<div class=\"ds-rnb\"><div class=\"t\"><span class=\"h\">U</span><span><small>08</small><b>Ula'tek</b></span></div><ul><li class=\"best\"><span>Jan'thrazet</span><span>+1.57%</span></li><li><span>Venomkeeper's Hood</span><span>+0.65%</span></li></ul></div>",
      "css": ".ds-rnb{width:220px;background:#0e1014;border:1px solid #d8b263;box-shadow:inset 0 0 0 1px #d8b263;font-family:Outfit,system-ui,sans-serif}.ds-rnb .t{display:grid;grid-template-columns:52px 1fr;gap:10px;align-items:center;padding:10px;background:#131519}.ds-rnb .h{width:52px;height:52px;display:grid;place-items:center;background:#171a1f;color:#5b6470;font-weight:800;clip-path:polygon(0 0,100% 0,calc(100% - 6px) 100%,0 100%)}.ds-rnb small{display:block;font:11px 'JetBrains Mono',monospace;color:#818b98}.ds-rnb b{font-size:14px;font-weight:600;color:#eef1f5}.ds-rnb ul{list-style:none;margin:0;padding:8px 10px 10px;display:grid;gap:2px}.ds-rnb li{display:flex;justify-content:space-between;font-size:13px;color:#eef1f5;min-height:26px;align-items:center}.ds-rnb li span:last-child{font-family:'JetBrains Mono',monospace;color:#3fd9a4}.ds-rnb li.best,.ds-rnb li.best span:last-child{color:#d8b263;font-weight:700}"
    },
    {
      "name": "Ribbon",
      "kind": "custom",
      "refersTo": "ribbon",
      "description": "Ranked dungeon ribbon with meter; best in gold.",
      "html": "<div class=\"ds-dg\"><div class=\"r best\"><div class=\"in\"><span class=\"k\">1</span><span>Temple of Sethraliss</span></div></div><span class=\"m\"><i style=\"width:90%\"></i></span></div>",
      "css": ".ds-dg{display:grid;grid-template-columns:260px 120px;gap:16px;align-items:center;font-family:Outfit,system-ui,sans-serif}.ds-dg .r{height:44px;padding:1px;background:#2a2f37;clip-path:polygon(0 0,100% 0,calc(100% - 11px) 100%,0 100%)}.ds-dg .r.best{background:#d8b263}.ds-dg .in{height:100%;display:flex;align-items:center;gap:10px;background:#131519;color:#eef1f5;font-size:14px;font-weight:600;clip-path:polygon(0 0,100% 0,calc(100% - 10px) 100%,0 100%)}.ds-dg .k{width:44px;height:100%;display:grid;place-items:center;background:#2a2f37;font:700 14px 'JetBrains Mono',monospace;clip-path:polygon(0 0,100% 0,calc(100% - 9px) 100%,0 100%)}.ds-dg .best .k{background:#d8b263;color:#0a0b0d}.ds-dg .m{display:block;height:10px;background:rgba(238,241,245,.08);clip-path:polygon(0 0,100% 0,calc(100% - 6px) 100%,0 100%)}.ds-dg .m i{display:block;height:100%;background:#d8b263}"
